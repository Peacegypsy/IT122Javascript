<html lang="en">
<head>
    <title>Album Details</title>
    <%- include('../partials/head'); %>
</head>
<body class="container">
<header>
    <%- include('../partials/header'); %>
</header>
    <% if (result) { %>
    <h3><%= result.artist %> </h3>
    <li>Artist: <%= result.artist %></li>
    <li>Album Name: <%= result.albumTitle %></li>
    <h5>Songs</h5>
    <p><%= result.songs.toString(); %>
    <% } %></p>
<hr>
<footer>
    <%- include('../partials/footer'); %>
</footer>
</body>
</html>